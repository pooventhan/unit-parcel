<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Disable static file handling - let Node.js handle everything -->
    <staticContent>
      <mimeMap fileExtension=".ts" mimeType="text/plain" />
    </staticContent>

    <!-- WebSocket support -->
    <webSocket enabled="true" />

    <!-- Node.js application will handle all routing -->
    <!-- No rewrite rules needed - Azure's Node.js runtime handles this -->

    <!-- Hide sensitive directories -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="apps" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Handle errors gracefully -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
